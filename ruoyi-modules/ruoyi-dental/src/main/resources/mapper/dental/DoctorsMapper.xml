<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.dental.mapper.DoctorsMapper">

    <resultMap type="Doctors" id="DoctorsResult">
        <result property="id"    column="id"    />
        <result property="userId"    column="user_id"    />
        <result property="name"    column="name"    />
        <result property="title"    column="title"    />
        <result property="hospital"    column="hospital"    />
        <result property="specialty"    column="specialty"    />
        <result property="detail"    column="detail"    />
    </resultMap>

    <sql id="selectDoctorsVo">
        select id, user_id, name, title, hospital, specialty, detail from tb_doctors
    </sql>

    <select id="selectDoctorsList" parameterType="Doctors" resultMap="DoctorsResult">
        <include refid="selectDoctorsVo"/>
        <where>
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="title != null  and title != ''"> and title = #{title}</if>
            <if test="hospital != null  and hospital != ''"> and hospital = #{hospital}</if>
        </where>
    </select>

    <select id="selectDoctorsById" parameterType="Long" resultMap="DoctorsResult">
        <include refid="selectDoctorsVo"/>
        where id = #{id}
    </select>

    <insert id="insertDoctors" parameterType="Doctors" useGeneratedKeys="true" keyProperty="id">
        insert into tb_doctors
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null and userId != ''">user_id,</if>
            <if test="name != null and name != ''">name,</if>
            <if test="title != null">title,</if>
            <if test="hospital != null">hospital,</if>
            <if test="specialty != null">specialty,</if>
            <if test="detail != null">detail,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null and userId != ''">#{userId},</if>
            <if test="name != null and name != ''">#{name},</if>
            <if test="title != null">#{title},</if>
            <if test="hospital != null">#{hospital},</if>
            <if test="specialty != null">#{specialty},</if>
            <if test="detail != null">#{detail},</if>
        </trim>
    </insert>

    <update id="updateDoctors" parameterType="Doctors">
        update tb_doctors
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null and userId != ''">user_id = #{userId},</if>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="title != null">title = #{title},</if>
            <if test="hospital != null">hospital = #{hospital},</if>
            <if test="specialty != null">specialty = #{specialty},</if>
            <if test="detail != null">detail = #{detail},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteDoctorsById" parameterType="Long">
        delete from tb_doctors where id = #{id}
    </delete>

    <delete id="deleteDoctorsByIds" parameterType="String">
        delete from tb_doctors where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>