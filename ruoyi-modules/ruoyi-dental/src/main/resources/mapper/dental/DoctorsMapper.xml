<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.dental.mapper.DoctorsMapper">

    <resultMap type="com.ruoyi.dental.domain.Doctors" id="DoctorsResult">
        <result property="id"    column="id"    />
        <result property="userId"    column="user_id"    />
        <result property="name"    column="name"    />
        <result property="status"    column="status"    />
        <result property="avatar"    column="avatar"    />
        <result property="title"    column="title"    />
        <result property="hospital"    column="hospital"    />
        <result property="specialty"    column="specialty"    />
        <result property="detail"    column="detail"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="appNum"    column="app_num"    />
    </resultMap>

    <sql id="selectDoctorsVo">
        select id, user_id, name, status, avatar, title, hospital, specialty, detail, create_time, update_time, app_num from tb_doctors
    </sql>

    <select id="selectDoctorsList" parameterType="com.ruoyi.dental.domain.Doctors" resultMap="DoctorsResult">
        <include refid="selectDoctorsVo"/>
        <where>
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="status != null "> and status = #{status}</if>
            <if test="title != null  and title != ''"> and title = #{title}</if>
            <if test="hospital != null  and hospital != ''"> and hospital = #{hospital}</if>
            <if test="specialty != null  and specialty != ''"> and specialty = #{specialty}</if>
            <if test="appNum != null "> and app_num = #{appNum}</if>
        </where>
    </select>

    <select id="selectDoctorsById" parameterType="Long" resultMap="DoctorsResult">
        <include refid="selectDoctorsVo"/>
        where id = #{id}
    </select>

    <insert id="insertDoctors" parameterType="com.ruoyi.dental.domain.Doctors" useGeneratedKeys="true" keyProperty="id">
        insert into tb_doctors
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="name != null and name != ''">name,</if>
            <if test="status != null">status,</if>
            <if test="avatar != null">avatar,</if>
            <if test="title != null">title,</if>
            <if test="hospital != null">hospital,</if>
            <if test="specialty != null">specialty,</if>
            <if test="detail != null">detail,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="appNum != null">app_num,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="name != null and name != ''">#{name},</if>
            <if test="status != null">#{status},</if>
            <if test="avatar != null">#{avatar},</if>
            <if test="title != null">#{title},</if>
            <if test="hospital != null">#{hospital},</if>
            <if test="specialty != null">#{specialty},</if>
            <if test="detail != null">#{detail},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="appNum != null">#{appNum},</if>
        </trim>
    </insert>

    <update id="updateDoctors" parameterType="com.ruoyi.dental.domain.Doctors">
        update tb_doctors
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null">user_id = #{userId},</if>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="status != null">status = #{status},</if>
            <if test="avatar != null">avatar = #{avatar},</if>
            <if test="title != null">title = #{title},</if>
            <if test="hospital != null">hospital = #{hospital},</if>
            <if test="specialty != null">specialty = #{specialty},</if>
            <if test="detail != null">detail = #{detail},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="appNum != null">app_num = #{appNum},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteDoctorsById" parameterType="Long">
        delete from tb_doctors where id = #{id}
    </delete>

    <delete id="deleteDoctorsByIds" parameterType="String">
        delete from tb_doctors where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>