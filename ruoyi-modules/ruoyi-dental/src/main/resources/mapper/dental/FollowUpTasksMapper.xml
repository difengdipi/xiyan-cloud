<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.dental.mapper.FollowUpTasksMapper">

    <resultMap type="com.ruoyi.dental.domain.FollowUpTasks" id="FollowUpTasksResult">
        <result property="taskId"    column="task_id"    />
        <result property="patientId"    column="patient_id"    />
        <result property="description"    column="description"    />
        <result property="dueDate"    column="due_date"    />
        <result property="status"    column="status"    />
        <result property="createdAt"    column="created_at"    />
        <result property="updatedAt"    column="updated_at"    />
    </resultMap>

    <sql id="selectFollowUpTasksVo">
        select task_id, patient_id, description, due_date, status, created_at, updated_at from tb_follow_up_tasks
    </sql>

    <select id="selectFollowUpTasksList" parameterType="com.ruoyi.dental.domain.FollowUpTasks" resultMap="FollowUpTasksResult">
        <include refid="selectFollowUpTasksVo"/>
        <where>
            <if test="patientId != null "> and patient_id = #{patientId}</if>
            <if test="description != null  and description != ''"> and description = #{description}</if>
            <if test="dueDate != null "> and due_date = #{dueDate}</if>
            <if test="status != null "> and status = #{status}</if>
        </where>
    </select>

    <select id="selectFollowUpTasksByTaskId" parameterType="Long" resultMap="FollowUpTasksResult">
        <include refid="selectFollowUpTasksVo"/>
        where task_id = #{taskId}
    </select>

    <insert id="insertFollowUpTasks" parameterType="com.ruoyi.dental.domain.FollowUpTasks" useGeneratedKeys="true" keyProperty="taskId">
        insert into tb_follow_up_tasks
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="patientId != null">patient_id,</if>
            <if test="description != null and description != ''">description,</if>
            <if test="dueDate != null">due_date,</if>
            <if test="status != null">status,</if>
            <if test="createdAt != null">created_at,</if>
            <if test="updatedAt != null">updated_at,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="patientId != null">#{patientId},</if>
            <if test="description != null and description != ''">#{description},</if>
            <if test="dueDate != null">#{dueDate},</if>
            <if test="status != null">#{status},</if>
            <if test="createdAt != null">#{createdAt},</if>
            <if test="updatedAt != null">#{updatedAt},</if>
        </trim>
    </insert>

    <update id="updateFollowUpTasks" parameterType="com.ruoyi.dental.domain.FollowUpTasks">
        update tb_follow_up_tasks
        <trim prefix="SET" suffixOverrides=",">
            <if test="patientId != null">patient_id = #{patientId},</if>
            <if test="description != null and description != ''">description = #{description},</if>
            <if test="dueDate != null">due_date = #{dueDate},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createdAt != null">created_at = #{createdAt},</if>
            <if test="updatedAt != null">updated_at = #{updatedAt},</if>
        </trim>
        where task_id = #{taskId}
    </update>

    <delete id="deleteFollowUpTasksByTaskId" parameterType="Long">
        delete from tb_follow_up_tasks where task_id = #{taskId}
    </delete>

    <delete id="deleteFollowUpTasksByTaskIds" parameterType="String">
        delete from tb_follow_up_tasks where task_id in
        <foreach item="taskId" collection="array" open="(" separator="," close=")">
            #{taskId}
        </foreach>
    </delete>
</mapper>