<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.dental.mapper.UserAppInfoMapper">

    <select id="getDoctorAppNum" resultType="com.ruoyi.dental.domain.vo.AppNumVo" >
        select docker_id as doctorId,count(docker_id) as num
        from tb_user_app_info
        where status = 2 group by docker_id
    </select>
</mapper>